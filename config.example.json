    "thinContentMinWords": 300,
    "titleMinLength": 30,
    "titleMaxLength": 60,
    "metaMinLength": 70,
    "metaMaxLength": 160,
    "slowResponseMs": 2500,
    "brokenLinkCheck": true,
    "brokenLinkSampleLimit": 200,
    "psiEnabled": true,
    "psiSampleSize": 5,
    "psiStrategies": ["mobile", "desktop"]
  },

  "actionPlan": {
    "enabled": true,
    "estimateImpact": true
  }
